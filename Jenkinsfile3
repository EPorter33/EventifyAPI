pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    environment {
        IMAGE_REPO = 'ejporter/eventifyapi'
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
        DOCKERHUB_USERNAME = 'ejporter'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Downloading latest code from GitHub'

                dir('ci-source') {
                    checkout scm
                }
            }
        }

        stage('Prepare') {
            steps {
                echo 'Preparing .NET application for Docker'

                sh '''
                    mkdir -p ci-runtime
                    cp ci-source/Dockerfile ci-runtime/
                    cp ci-source/docker-compose.yml ci-runtime/
                    tar --exclude='.git' -C ci-source -c . | tar -C ci-runtime -x
                '''
            }
        }

        stage('Build') {
            steps {
                dir('ci-runtime') {

                    sh '''
                        docker-compose down --remove-orphans || true
                    '''

                    sh '''
                        docker-compose build eventifyapi
                    '''
                }
            }
        }

        stage('Run Containers') {
            steps {
                dir('ci-runtime') {

                    sh '''
                        docker-compose up -d --no-build db eventifyapi
                        docker-compose ps -a
                    '''
                }
            }
        }

        stage('Testing') {
            steps {
                echo 'Testing .NET web application endpoint'

                dir('ci-runtime') {

                    sh '''
                        APP_PORT=$(docker-compose port eventifyapi 5000 | cut -d: -f2)

                        echo "Detected application port: $APP_PORT"

                        sleep 10

                        echo "===== CURL TEST ====="

                        curl -v http://127.0.0.1:$APP_PORT/ || true

                        echo "===== SWAGGER TEST ====="

                        curl -v http://127.0.0.1:$APP_PORT/swagger || true

                        echo "===== CONTAINER LOGS ====="

                        docker-compose logs eventifyapi
                    '''
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                dir('ci-runtime') {

                    sh '''
                        set +x

                        IMAGE_ID=$(docker-compose images -q eventifyapi)

                        test -n "$IMAGE_ID"

                        docker tag "$IMAGE_ID" "$IMAGE_REPO:latest"

                        echo "$DOCKERHUB_CREDENTIALS_PSW" | docker login \
                            -u "$DOCKERHUB_CREDENTIALS_USR" \
                            --password-stdin

                        docker push "$IMAGE_REPO:latest"

                        docker logout
                    '''
                }
            }
        }
    }

    post {

        always {

            script {

                if (fileExists('ci-runtime')) {

                    dir('ci-runtime') {

                        sh '''
                            if command -v docker > /dev/null; then

                                docker-compose ps -a || true

                                docker-compose logs --tail=20 eventifyapi || true

                                docker-compose logs --tail=20 db || true

                                docker-compose down --remove-orphans || true

                                docker image rm "$IMAGE_REPO:latest" || true

                                docker builder prune -f || true

                            else

                                echo "Docker CLI is not installed on this Jenkins node, skipping Docker cleanup."

                            fi
                        '''
                    }

                } else {

                    sh '''
                        if command -v docker > /dev/null; then
                            docker image rm "$IMAGE_REPO:latest" || true
                        fi
                    '''
                }
            }
        }

        success {
            echo 'Pipeline CI checks passed.'
        }

        failure {
            echo 'Pipeline failed; inspect Console Output.'
        }
    }
}